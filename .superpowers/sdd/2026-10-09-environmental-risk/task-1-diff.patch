diff --git "a/src\\server\\environmental-risk.ts" "b/src\\server\\environmental-risk.ts"
new file mode 100644
index 0000000..2f22a94
--- /dev/null
+++ "b/src\\server\\environmental-risk.ts"
@@ -0,0 +1,193 @@
+export const ENVIRONMENTAL_RADII_KM = [25, 50, 100, 200] as const;
+
+export type EnvironmentalRadiusKm = (typeof ENVIRONMENTAL_RADII_KM)[number];
+export type EnvironmentalRiskStatus =
+  | "comparable"
+  | "insufficient-coverage"
+  | "no-neighbors"
+  | "coordinates-unavailable";
+
+export type EnvironmentalRiskSummary = {
+  radiusKm: EnvironmentalRadiusKm;
+  value: number | null;
+  status: EnvironmentalRiskStatus;
+  scoredNeighborCount: number;
+  totalNeighborCount: number;
+  weightedCoverageRatio: number | null;
+};
+
+export type EnvironmentalNeighborRow = {
+  targetInseeCode: string;
+  neighborInseeCode: string;
+  distanceKm: number;
+  comparativeIndex: number | null;
+};
+
+type CityEnvironmentalRiskQuery = {
+  text: string;
+  values: [string, number, string];
+};
+
+type MapEnvironmentalRiskQuery = {
+  text: string;
+  values: [string[], number, string, number];
+};
+
+export function buildCityEnvironmentalRiskQuery(
+  inseeCode: string,
+  year: number,
+  snapshotId: string
+): CityEnvironmentalRiskQuery {
+  return {
+    values: [inseeCode, year, snapshotId],
+    text: `
+with target as (
+  select insee_code, geom, (geom is not null) as coordinates_available
+  from cities
+  where insee_code = $1
+), environmental_radii(radius_km) as (
+  values (25::integer), (50::integer), (100::integer), (200::integer)
+)
+select
+  environmental_radii.radius_km,
+  target.coordinates_available as target_coordinates_available,
+  target.insee_code as target_insee_code,
+  neighbor.insee_code as neighbor_insee_code,
+  neighbor.distance_km,
+  metrics.comparative_index
+from target
+cross join environmental_radii
+left join lateral (
+  select
+    c.insee_code,
+    c.geom,
+    st_distance(c.geom, target.geom) / 1000.0 as distance_km
+  from cities c
+  where target.geom is not null
+    and c.geom is not null
+    and c.insee_code <> target.insee_code
+    and st_dwithin(c.geom, target.geom, environmental_radii.radius_km * 1000)
+    and st_distance(c.geom, target.geom) < environmental_radii.radius_km * 1000
+) neighbor on true
+left join search_metrics_city_year_comparative metrics
+  on metrics.city_insee_code = neighbor.insee_code
+ and metrics.year = $2
+ and metrics.snapshot_id = $3
+order by environmental_radii.radius_km, neighbor.insee_code
+`.trim()
+  };
+}
+
+export function buildMapEnvironmentalRiskQuery(
+  inseeCodes: string[],
+  year: number,
+  snapshotId: string,
+  radiusKm: EnvironmentalRadiusKm
+): MapEnvironmentalRiskQuery {
+  return {
+    values: [inseeCodes, year, snapshotId, radiusKm * 1000],
+    text: `
+with requested_targets as (
+  select unnest($1::varchar[]) as requested_insee_code
+), targets as (
+  select
+    requested_targets.requested_insee_code,
+    cities.insee_code,
+    cities.geom,
+    (cities.geom is not null) as coordinates_available
+  from requested_targets
+  left join cities on cities.insee_code = requested_targets.requested_insee_code
+)
+select
+  targets.requested_insee_code as target_insee_code,
+  targets.coordinates_available as target_coordinates_available,
+  neighbor.insee_code as neighbor_insee_code,
+  neighbor.distance_km,
+  metrics.comparative_index
+from targets
+left join lateral (
+  select
+    c.insee_code,
+    c.geom,
+    st_distance(c.geom, targets.geom) / 1000.0 as distance_km
+  from cities c
+  where targets.geom is not null
+    and c.geom is not null
+    and c.insee_code <> targets.insee_code
+    and st_dwithin(c.geom, targets.geom, $4)
+    and st_distance(c.geom, targets.geom) < $4
+) neighbor on true
+left join search_metrics_city_year_comparative metrics
+  on metrics.city_insee_code = neighbor.insee_code
+ and metrics.year = $2
+ and metrics.snapshot_id = $3
+order by targets.requested_insee_code, neighbor.insee_code
+`.trim()
+  };
+}
+
+export function summarizeEnvironmentalRisk(
+  targetCode: string,
+  radiusKm: EnvironmentalRadiusKm,
+  coordinatesAvailable: boolean,
+  neighborRows: EnvironmentalNeighborRow[]
+): EnvironmentalRiskSummary {
+  if (!coordinatesAvailable) {
+    return emptySummary(radiusKm, "coordinates-unavailable");
+  }
+
+  const neighbors = neighborRows.filter((neighbor) =>
+    neighbor.neighborInseeCode !== targetCode &&
+    Number.isFinite(neighbor.distanceKm) &&
+    neighbor.distanceKm >= 0 &&
+    neighbor.distanceKm < radiusKm
+  );
+
+  if (neighbors.length === 0) {
+    return emptySummary(radiusKm, "no-neighbors");
+  }
+
+  let totalWeight = 0;
+  let scoredWeight = 0;
+  let weightedIndex = 0;
+  let scoredNeighborCount = 0;
+
+  for (const neighbor of neighbors) {
+    const weight = 1 - neighbor.distanceKm / radiusKm;
+    totalWeight += weight;
+
+    if (neighbor.comparativeIndex === null || !Number.isFinite(neighbor.comparativeIndex)) {
+      continue;
+    }
+
+    scoredNeighborCount += 1;
+    scoredWeight += weight;
+    weightedIndex += neighbor.comparativeIndex * weight;
+  }
+
+  const weightedCoverageRatio = scoredWeight / totalWeight;
+  const comparable = scoredNeighborCount >= 3 && weightedCoverageRatio >= 0.5;
+
+  return {
+    radiusKm,
+    value: comparable ? Math.round((weightedIndex / scoredWeight) * 10) / 10 : null,
+    status: comparable ? "comparable" : "insufficient-coverage",
+    scoredNeighborCount,
+    totalNeighborCount: neighbors.length,
+    weightedCoverageRatio
+  };
+}
+
+function emptySummary(
+  radiusKm: EnvironmentalRadiusKm,
+  status: "no-neighbors" | "coordinates-unavailable"
+): EnvironmentalRiskSummary {
+  return {
+    radiusKm,
+    value: null,
+    status,
+    scoredNeighborCount: 0,
+    totalNeighborCount: 0,
+    weightedCoverageRatio: null
+  };
+}

diff --git "a/tests\\environmental-risk.test.ts" "b/tests\\environmental-risk.test.ts"
new file mode 100644
index 0000000..c9cb121
--- /dev/null
+++ "b/tests\\environmental-risk.test.ts"
@@ -0,0 +1,181 @@
+import { describe, expect, it } from "vitest";
+
+import {
+  ENVIRONMENTAL_RADII_KM,
+  buildCityEnvironmentalRiskQuery,
+  buildMapEnvironmentalRiskQuery,
+  summarizeEnvironmentalRisk,
+  type EnvironmentalNeighborRow
+} from "../src/server/environmental-risk";
+
+function neighbor(
+  neighborInseeCode: string,
+  distanceKm: number,
+  comparativeIndex: number | null,
+  targetInseeCode = "95584"
+): EnvironmentalNeighborRow {
+  return { targetInseeCode, neighborInseeCode, distanceKm, comparativeIndex };
+}
+
+describe("environmental risk summaries", () => {
+  it("uses the linear distance weights for a comparable score", () => {
+    const summary = summarizeEnvironmentalRisk("95584", 25, true, [
+      neighbor("01001", 0, 20),
+      neighbor("01002", 12.5, 80),
+      neighbor("01003", 10, 40)
+    ]);
+
+    expect(summary).toEqual({
+      radiusKm: 25,
+      value: 40,
+      status: "comparable",
+      scoredNeighborCount: 3,
+      totalNeighborCount: 3,
+      weightedCoverageRatio: 1
+    });
+  });
+
+  it("excludes the target commune from its own neighborhood", () => {
+    const summary = summarizeEnvironmentalRisk("95584", 25, true, [
+      neighbor("95584", 0, 100),
+      neighbor("01001", 0, 20),
+      neighbor("01002", 0, 20),
+      neighbor("01003", 0, 20)
+    ]);
+
+    expect(summary.value).toBe(20);
+    expect(summary.scoredNeighborCount).toBe(3);
+    expect(summary.totalNeighborCount).toBe(3);
+  });
+
+  it("keeps neighbors without an index in the weighted coverage denominator", () => {
+    const summary = summarizeEnvironmentalRisk("95584", 25, true, [
+      neighbor("01001", 0, 40),
+      neighbor("01002", 0, 40),
+      neighbor("01003", 0, 40),
+      neighbor("01004", 0, null)
+    ]);
+
+    expect(summary.value).toBe(40);
+    expect(summary.scoredNeighborCount).toBe(3);
+    expect(summary.totalNeighborCount).toBe(4);
+    expect(summary.weightedCoverageRatio).toBe(0.75);
+  });
+
+  it("does not expose a value with fewer than three scored neighbors", () => {
+    const summary = summarizeEnvironmentalRisk("95584", 25, true, [
+      neighbor("01001", 0, 20),
+      neighbor("01002", 12.5, 80)
+    ]);
+
+    expect(summary.value).toBeNull();
+    expect(summary.status).toBe("insufficient-coverage");
+    expect(summary.scoredNeighborCount).toBe(2);
+  });
+
+  it("accepts exactly 50 percent weighted coverage", () => {
+    const summary = summarizeEnvironmentalRisk("95584", 25, true, [
+      neighbor("01001", 0, 20),
+      neighbor("01002", 0, 40),
+      neighbor("01003", 0, 60),
+      neighbor("01004", 0, null),
+      neighbor("01005", 0, null),
+      neighbor("01006", 0, null)
+    ]);
+
+    expect(summary.value).toBe(40);
+    expect(summary.status).toBe("comparable");
+    expect(summary.weightedCoverageRatio).toBe(0.5);
+  });
+
+  it("reports insufficient coverage below 50 percent", () => {
+    const summary = summarizeEnvironmentalRisk("95584", 25, true, [
+      neighbor("01001", 0, 20),
+      neighbor("01002", 0, 40),
+      neighbor("01003", 0, 60),
+      neighbor("01004", 0, null),
+      neighbor("01005", 0, null),
+      neighbor("01006", 0, null),
+      neighbor("01007", 0, null)
+    ]);
+
+    expect(summary.value).toBeNull();
+    expect(summary.status).toBe("insufficient-coverage");
+    expect(summary.weightedCoverageRatio).toBeLessThan(0.5);
+  });
+
+  it("uses a weight of one at zero distance", () => {
+    const summary = summarizeEnvironmentalRisk("95584", 25, true, [
+      neighbor("01001", 0, 20),
+      neighbor("01002", 12.5, 80),
+      neighbor("01003", 10, 40)
+    ]);
+
+    expect(summary.value).toBe(40);
+  });
+
+  it("excludes neighbors exactly on the radius boundary", () => {
+    const summary = summarizeEnvironmentalRisk("95584", 25, true, [
+      neighbor("01001", 0, 50),
+      neighbor("01002", 10, 50),
+      neighbor("01003", 20, 50),
+      neighbor("01004", 25, null)
+    ]);
+
+    expect(summary.totalNeighborCount).toBe(3);
+    expect(summary.weightedCoverageRatio).toBe(1);
+  });
+
+  it("reports unavailable coordinates without manufacturing a score", () => {
+    const summary = summarizeEnvironmentalRisk("95584", 25, false, []);
+
+    expect(summary).toEqual({
+      radiusKm: 25,
+      value: null,
+      status: "coordinates-unavailable",
+      scoredNeighborCount: 0,
+      totalNeighborCount: 0,
+      weightedCoverageRatio: null
+    });
+  });
+
+  it("reports a geolocated target with no neighbors separately", () => {
+    const summary = summarizeEnvironmentalRisk("95584", 25, true, []);
+
+    expect(summary.status).toBe("no-neighbors");
+    expect(summary.value).toBeNull();
+    expect(summary.weightedCoverageRatio).toBeNull();
+  });
+});
+
+describe("environmental risk queries", () => {
+  it("defines the four supported radii", () => {
+    expect(ENVIRONMENTAL_RADII_KM).toEqual([25, 50, 100, 200]);
+  });
+
+  it("queries one city's neighbors with its requested year and snapshot", () => {
+    const query = buildCityEnvironmentalRiskQuery("95584", 2025, "42");
+
+    expect(query.values).toEqual(["95584", 2025, "42"]);
+    expect(query.text).toContain("st_dwithin");
+    expect(query.text).toContain("200");
+    expect(query.text).toContain("c.insee_code <> target.insee_code");
+    expect(query.text).toContain("metrics.year = $2");
+    expect(query.text).toContain("metrics.snapshot_id = $3");
+    expect(query.text).toContain("left join search_metrics_city_year_comparative");
+    expect(query.text).toMatch(/st_distance[\s\S]*<|<[^\n]*st_distance/i);
+  });
+
+  it("queries map targets in a batch and retains neighbors with missing indices", () => {
+    const query = buildMapEnvironmentalRiskQuery(["95584", "95313"], 2025, "42", 50);
+
+    expect(query.values).toEqual([["95584", "95313"], 2025, "42", 50000]);
+    expect(query.text).toContain("unnest($1::varchar[])");
+    expect(query.text).toContain("metrics.year = $2");
+    expect(query.text).toContain("metrics.snapshot_id = $3");
+    expect(query.text).toContain("st_dwithin");
+    expect(query.text).toContain("c.insee_code <> targets.insee_code");
+    expect(query.text).toContain("left join search_metrics_city_year_comparative");
+    expect(query.text).toContain("< $4");
+  });
+});

